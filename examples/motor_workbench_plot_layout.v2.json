{
  "schema_version": 2,
  "column_source": "product_stations",
  "default_plot_style": {
    "background_color": "#FFFFFF",
    "curve_line_width": 1.5,
    "curve_line_style": "solid",
    "grid": {
      "visible": true,
      "color": "#CDD8E5",
      "line_style": "solid",
      "line_width": 1.0
    },
    "legend": {
      "visible": true,
      "position": "top_right"
    }
  },
  "default_condition_display": {
    "layout": "single_canvas",
    "condition_source": "current_configuration",
    "x_axis_mode": "condition_local",
    "condition_gap_px": 16,
    "show_condition_names": true,
    "show_condition_separator": true
  },
  "plot_templates": {
    "spl_plot": {
      "title": "声压级（SPL）",
      "analysis_item_name": "声压级 (SPL) 1",
      "analysis_type": "SPL",
      "chart_type": "line",
      "display_downsampling": {
        "method": "preserve_min_max",
        "pixel_bucket_width": 1
      },
      "channel_display": {
        "show_all_analyzed_channels": false,
        "display_wav_channels": [
          1
        ]
      },
      "x_axis": {
        "label": "时间",
        "scale": "linear",
        "auto_range": true
      },
      "y_axis": {
        "label": "声压级",
        "scale": "linear",
        "auto_range": true,
        "empty_data_range_min": 0,
        "empty_data_range_max": 100
      }
    },
    "spectrogram_plot": {
      "title": "时频图",
      "analysis_item_name": "频谱分析 (Spec) 1",
      "analysis_type": "Spec",
      "chart_type": "heatmap",
      "plot_style": {
        "grid": {
          "visible": false,
          "color": "#E5EAF0",
          "line_style": "solid",
          "line_width": 1.0
        }
      },
      "channel_display": {
        "show_all_analyzed_channels": false,
        "display_wav_channels": [
          1
        ]
      },
      "x_axis": {
        "label": "时间",
        "scale": "linear",
        "auto_range": true
      },
      "y_axis": {
        "label": "频率",
        "scale": "linear",
        "auto_range": false,
        "range_min": 0,
        "range_max": 20000
      },
      "spectrogram": {
        "color_map": "viridis",
        "show_color_bar": false,
        "color_range": {
          "mode": "fixed",
          "min_db": 0,
          "max_db": 100
        }
      }
    },
    "fft_plot": {
      "title": "频谱（FFT）",
      "analysis_item_name": "快速傅里叶变换 (FFT) 1",
      "analysis_type": "FFT",
      "chart_type": "line",
      "display_downsampling": {
        "method": "preserve_min_max",
        "pixel_bucket_width": 1
      },
      "channel_display": {
        "show_all_analyzed_channels": false,
        "display_wav_channels": [
          1
        ]
      },
      "x_axis": {
        "label": "频率",
        "scale": "log",
        "auto_range": false,
        "range_min": 20,
        "range_max": 20000
      },
      "y_axis": {
        "label": "电平",
        "scale": "linear",
        "auto_range": true,
        "empty_data_range_min": 0,
        "empty_data_range_max": 100
      },
      "condition_display": {
        "layout": "single_canvas",
        "condition_source": "current_configuration",
        "x_axis_mode": "condition_local",
        "condition_gap_px": 16,
        "show_condition_names": true,
        "show_condition_separator": true
      }
    },
    "vibration_rms_plot": {
      "title": "振动 RMS",
      "analysis_item_name": "振动 RMS 1",
      "analysis_type": "VIBRATION_RMS",
      "chart_type": "line",
      "value_unit": "m/s²",
      "display_downsampling": {
        "method": "preserve_min_max",
        "pixel_bucket_width": 1
      },
      "channel_display": {
        "show_all_analyzed_channels": false,
        "display_wav_channels": [
          1,
          2,
          3
        ]
      },
      "x_axis": {
        "label": "时间",
        "scale": "linear",
        "auto_range": true
      },
      "y_axis": {
        "label": "RMS",
        "scale": "linear",
        "auto_range": false,
        "range_min": 0,
        "range_max": 0.15
      },
      "data_source": "simulated",
      "plot_style": {
        "curve_line_width": 1.5,
        "channel_curve_styles": [
          {
            "wav_channel": 1,
            "curve_color": "#3B82F6"
          },
          {
            "wav_channel": 2,
            "curve_color": "#14B8A6"
          },
          {
            "wav_channel": 3,
            "curve_color": "#F59E0B"
          }
        ]
      }
    }
  },
  "row_templates": [
    {
      "plot_template": "spl_plot"
    },
    {
      "plot_template": "vibration_rms_plot"
    }
  ]
}
